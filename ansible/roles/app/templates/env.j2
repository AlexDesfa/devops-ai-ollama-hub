# Environment Configuration
ENVIRONMENT={{ env }}
DOMAIN_SUFFIX={{ domain_suffix }}

# Docker Registry Configuration
DOCKER_REGISTRY={{ docker_registry | default('docker.io') }}

# Resource Limits
OLLAMA_MEMORY_LIMIT=14g
OPENWEBUI_MEMORY_LIMIT=500m
QDRANT_MEMORY_LIMIT=2g
RAG_API_MEMORY_LIMIT=500m
GRAFANA_MEMORY_LIMIT=500m

# Service URLs
OLLAMA_API_BASE=http://ollama:11434
QDRANT_URL=http://qdrant:6333

# Grafana Configuration
GF_SECURITY_ADMIN_PASSWORD={{ grafana_admin_password | default('admin') }}
GF_SERVER_ROOT_URL=http://grafana.{{ domain_suffix }}
GF_INSTALL_PLUGINS=grafana-piechart-panel,grafana-worldmap-panel

# NVIDIA Configuration
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility

# Monitoring Configuration
PROMETHEUS_RETENTION_DAYS=15
LOGGING_LEVEL={{ 'DEBUG' if env == 'development' else 'INFO' }}

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=3
